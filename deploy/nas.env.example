# Copy outside Git to a NAS-local .env.nas after checking that these paths are new.
# This is the explicitly labelled synthetic demonstration, not an institution's production DB.
TRADE_RELEASE=nas-preview
TRADE_NODE_ENV=development
TRADE_DEMO_MODE=true
TRADE_DATA_DIR=/volume2/docker/trade/demo-data
TRADE_BACKUP_DIR=/volume2/docker/trade/backups
TRADE_LOCAL_PORT=14310
# Use nas.network.compose.yml only after checking Docker IPAM and NAS routes.
TRADE_NETWORK_SUBNET=10.253.43.0/28

# Only for a separate connector (nas.tunnel.compose.yml); existing Tunnel needs neither value.
CLOUDFLARED_VERSION=2026.5.2
TRADE_TUNNEL_TOKEN_FILE=/volume2/docker/trade/secrets/tunnel-token
