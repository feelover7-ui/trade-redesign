# Copy to the source checkout's .env.ozd on the licensed conversion host.
# Keep this token DIFFERENT from DeepSeek/procurement keys. >=32 random characters.
OZD_BRIDGE_TOKEN=
OZD_BRIDGE_HOST=127.0.0.1
OZD_BRIDGE_PORT=4318
OZD_PRIVATE_NETWORK_APPROVED=false
OZD_ENGINE_APPROVED=false
# Absolute path to a locally approved export adapter or executable.
# Obtain invocation syntax from the installed licensed OZ SDK; do not guess flags.
OZD_CONVERTER_EXECUTABLE=
# JSON string array must include {input} and {output} placeholders.
OZD_CONVERTER_ARGS_JSON=[]
OZD_ENGINE_TIMEOUT_MS=45000
